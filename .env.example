# Copy to `.env.local` (local) or set in Vercel → Project → Settings → Environment Variables.

# `/api` = kitchen in this same Next.js app (recommended for Vercel).
# `mock` = in-browser localStorage only (same device).
NEXT_PUBLIC_API_URL=/api

# Public site URL (printed QR codes). On Vercel set to https://YOUR-APP.vercel.app
NEXT_PUBLIC_APP_URL=

# --- Supabase (server) — required for live floor ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Prefer service_role on the server. Never expose it as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback if you only have the publishable/anon key (after running supabase/schema.sql):
SUPABASE_PUBLISHABLE_KEY=

# Kitchen PIN + resume HMAC (server). Prefer these over NEXT_PUBLIC_* in production.
STAFF_PIN=2468
RESUME_SECRET=change-me-resume-secret
TAX_RATE=0.05
SESSION_IDLE_MINUTES=15

# Optional: only if you run a *separate* kitchen process/deploy and want the café to proxy.
# Leave empty on Vercel so /api uses this app's own route handlers.
# BACKEND_ORIGIN=http://127.0.0.1:3001

NEXT_PUBLIC_RESTAURANT_NAME=Vistar
NEXT_PUBLIC_TAGLINE=Freshly Made. Boldly Flavoured. Perfectly Loaded.
NEXT_PUBLIC_WELCOME_MESSAGE=Welcome to Vistar Sandwich
NEXT_PUBLIC_WELCOME_BODY=Sandwiches, fries, iced coffees, and shakes — order from your table. The counter sees it live.
NEXT_PUBLIC_LOGO_SRC=/logo.jpg
NEXT_PUBLIC_LOGO_LIGHT_SRC=/logo.jpg
NEXT_PUBLIC_HERO_SRC=
NEXT_PUBLIC_SPLASH_MS=2200
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN
NEXT_PUBLIC_TAX_RATE=0.05
NEXT_PUBLIC_TAX_LABEL=GST
NEXT_PUBLIC_POLL_INTERVAL_MS=3000
NEXT_PUBLIC_SESSION_IDLE_MINUTES=15
NEXT_PUBLIC_STAFF_PIN=2468
NEXT_PUBLIC_RESUME_SECRET=vistar-resume-demo
NEXT_PUBLIC_UPI_VPA=vistarcafe@upi
