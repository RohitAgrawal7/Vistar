# Kitchen API — copy to `.env.local` in this folder.

PORT=3001
STAFF_PIN=2468
RESUME_SECRET=vistar-resume-demo
TAX_RATE=0
SESSION_IDLE_MINUTES=15

# Supabase Postgres (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Prefer the secret / service_role key on the server.
# The publishable key works after schema.sql RLS policies are applied.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional. Empty allows any browser origin (phone + admin on the LAN).
CORS_ORIGIN=
